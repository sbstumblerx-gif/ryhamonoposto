{
  "version": 1,
  "sdk_version": "3.0.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "ryh-monoposto",
      "version": "0.3.0",
      "title": "RyhäMonoposto"
    },
    "tools": [
      {
        "name": "list_races",
        "title": "Kilpailut",
        "description": "List public RyhäMonoposto races with dates, flags, rounds and links, optionally searching race names.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "maxLength": 100,
              "description": "Optional text to find in a race name."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30,
              "description": "Maximum races returned (1–100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_drivers",
        "title": "Kuljettajat",
        "description": "Read public RyhäMonoposto driver names, numbers, flags, current teams and recorded contract end years.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "Maximum drivers returned (1–100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_calendar_sessions",
        "title": "Kalenterin sessiot",
        "description": "Read public scheduled RyhäMonoposto sessions for a month, including race names and links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "year": {
              "type": "integer",
              "minimum": 2026,
              "maximum": 2040,
              "description": "Calendar year (2026–2040)."
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Calendar month (1–12)."
            }
          },
          "required": [
            "year",
            "month"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_standings",
        "title": "Kuljettajien MM-tilanne",
        "description": "Read current RyhäMonoposto driver standings. Defaults to the explicitly active season, not all-time totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_team_standings",
        "title": "Tiimien MM-tilanne",
        "description": "Read current RyhäMonoposto team standings. Defaults to the explicitly active season, not all-time totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_driver_contracts",
        "title": "Kuljettajien sopimukset",
        "description": "Read public driver contract status and current team. Uses the active season context; missing or unknown values must not be guessed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "maxLength": 100,
              "description": "Optional driver name search."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_team_engine",
        "title": "Tiimien moottoritoimittajat",
        "description": "Read public team engine suppliers and registered engine contract years.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "maxLength": 100,
              "description": "Optional team name search."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_latest_race",
        "title": "Viimeisin kilpailu",
        "description": "Read the most recently updated public race result or qualifying report.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_race_result",
        "title": "Kilpailun tulos",
        "description": "Read qualifying and race result text for a named RyhäMonoposto race.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Race name or part of its name."
            }
          },
          "required": [
            "search"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_ryhamonoposto",
        "title": "Hae RyhäMonopostosta",
        "description": "Search public RyhäMonoposto drivers, teams, races and news. Returns short matches with links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Search term, such as a driver, team, race or news title."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
